class Solution { 
    public String longestPalindrome(String s) { 
 
        // Build transformed string 
        StringBuilder t = new StringBuilder("#"); 
 
        for (char c : s.toCharArray()) { 
            t.append(c); 
            t.append("#"); 
        } 
 
        int n = t.length(); 
        int[] p = new int[n]; 
 
        int l = 0; 
        int r = 0; 
 
        // Manacher 
        for (int i = 0; i < n; i++) { 
 
            if (i < r) {
                p[i] = Math.min(r - i, p[l + r - i]);
            } else {
                p[i] = 0;
            }
 
            while (i + p[i] + 1 < n && 
                   i - p[i] - 1 >= 0 && 
                   t.charAt(i + p[i] + 1) == 
                   t.charAt(i - p[i] - 1)) { 
 
                p[i]++; 
            } 
 
            if (i + p[i] > r) { 
                l = i - p[i]; 
                r = i + p[i]; 
            } 
        } 
 
        // Find maximum palindrome 
        int maxLen = 0; 
        int center = 0; 
 
        for (int i = 0; i < n; i++) { 
            if (p[i] > maxLen) { 
                maxLen = p[i]; 
                center = i; 
            } 
        } 
 
        // Convert back to original string 
        int start = (center - maxLen) / 2; 
 
        return s.substring(start, start + maxLen); 
    } 
}
