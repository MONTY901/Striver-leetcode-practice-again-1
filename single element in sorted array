class Solution {
    public int singleNonDuplicate(int[] nums) {

        int l = 0;
        int r = nums.length - 1;

        while (l < r) {

            int mid = l + (r - l) / 2;

            // Make mid even so mid and mid+1 form a pair
            if (mid % 2 == 1) {
                mid--;
            }

            // Correct pair → single element is on the right
            if (nums[mid] == nums[mid + 1]) {
                l = mid + 2;
            }

            // Broken pair → single element is at mid or on the left
            else {
                r = mid;
            }
        }

        return nums[l];
    }
}
