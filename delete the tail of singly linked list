/*
Definition of singly linked list:
class ListNode {
    public int data;
    public ListNode next;

    ListNode() {
        data = 0;
        next = null;
    }

    ListNode(int x) {
        data = x;
        next = null;
    }

    ListNode(int x, ListNode next) {
        data = x;
        this.next = next;
    }
}
*/

class Solution {
    public ListNode deleteTail(ListNode head) {

        // Case 1: Empty list or only one node
        if (head == null || head.next == null) {
            return null;
        }

        ListNode temp = head;

        // Case 2: Reach the second-last node
        while (temp.next.next != null) {
            temp = temp.next;
        }

        // Case 3: Remove the last node
        temp.next = null;

        return head;
    }
}
