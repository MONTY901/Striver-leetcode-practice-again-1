class Solution {
    int upperBound(int[] arr, int target) {
        int low = 0;
        int high = arr.length;
        int ans = arr.length;

        while (low < high) {
            int mid = low + (high - low) / 2;

            if (arr[mid] > target) {
                ans = mid;
                high = mid;       // FIX
            } else {
                low = mid + 1;
            }
        }

        return ans;
    }
}
